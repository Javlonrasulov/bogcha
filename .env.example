# ─── Ma'lumotlar bazasi ───────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bogcha?schema=public"

# ─── API ──────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
API_PREFIX=api/v1

# Ishlab chiqarishda `openssl rand -base64 48` bilan yangi kalit yarating.
JWT_ACCESS_SECRET="dev-access-secret-change-me-in-production-please"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-in-production-please"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

CORS_ORIGINS="http://localhost:3000"
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=200

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# Redis (ixtiyoriy). Berilmasa navbat jarayon ichida ishlaydi.
# REDIS_URL=redis://localhost:6379

# ─── Rejalashtirilgan vazifalar ───────────────────────────────
# Kunlik anomaliya tekshiruvi: davomat pasayishi va qarzdorlik o'sishi.
SCHEDULER_ENABLED=true
ANOMALY_CHECK_CRON="0 19 * * *"

# ─── Zaxiralash ───────────────────────────────────────────────
# pg_dump PATH'da bo'lishi kerak, aks holda PG_DUMP_PATH'ni to'liq ko'rsating.
BACKUP_ENABLED=false
BACKUP_DIR=./backups
BACKUP_DAILY_CRON="0 2 * * *"
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=12
PG_DUMP_PATH=pg_dump

# ─── Web ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
